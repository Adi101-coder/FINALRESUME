# =============================================================================
# ResumeBuild — Environment Configuration
# Copy to .env in project root AND ensure frontend/.env.local exists
# =============================================================================

# --- Tier 1: Set these first (biggest impact) -----------------------------

# LLM resume parsing — without this, heuristic parser only (fast but shallow)
# OpenAI: leave OPENAI_BASE_URL empty and use sk-... key + gpt-4o-mini
# OpenRouter: https://openrouter.ai/keys — same env vars:
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Frontend must know backend URL (also set in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Tier 2: Matching quality (first run downloads ~90MB model) -----------

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Job boards (Indeed, ZipRecruiter, LinkedIn, Glassdoor) ---------------

# Indeed RSS domain — use www.indeed.co.in for India, etc.
INDEED_DOMAIN=www.indeed.com

# Optional cookies for boards that block datacenter IPs (LinkedIn, Glassdoor)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_SESSION_COOKIE=
GLASSDOOR_SESSION_COOKIE=

# Greenhouse company career pages (comma-separated board slugs)
# Find slug in URL: boards.greenhouse.io/stripe → stripe
GREENHOUSE_BOARDS=stripe,figma,airbnb,netflix,datadog

# --- Tier 3: Tuning -------------------------------------------------------

MATCH_THRESHOLD=75
TOP_JOBS_LIMIT=50

# --- Tier 4: Database (set this BEFORE deploy) ----------------------------
#
# Option A — Local Postgres via Docker (recommended for dev):
#   docker compose up -d postgres
#   DATABASE_URL=postgresql://resumebuild:resumebuild@localhost:5432/resumebuild
#
# Option B — Neon (free cloud Postgres, good for deploy):
#   1. https://neon.tech → New project → copy connection string
#   2. Paste below (keep ?sslmode=require if Neon includes it)
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Option C — Supabase / Railway Postgres: same format as Neon
#
# Option D — SQLite (local only, data lost on many hosts):
#   DATABASE_URL=sqlite:///./resumebuild.db

DEBUG=true
DATABASE_URL=postgresql://resumebuild:resumebuild@localhost:5432/resumebuild

# Redis/Celery — not used by core prototype yet; safe to leave
REDIS_URL=redis://localhost:6379/0

# Production — comma-separated or JSON list of allowed frontend origins
# CORS_ORIGINS=https://resume-build-weld.vercel.app,http://localhost:3000

# --- Tier 5: Logging (turn down for speed after debugging) ----------------

LOG_LEVEL=DEBUG
SQL_ECHO=true
# LOG_LEVEL=INFO
# SQL_ECHO=false
